<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chi tiết sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><main class="container narrow"><h1>Chi tiết sản phẩm</h1><dl class="details"><dt>Mã sản phẩm</dt><dd><c:out value="${product.id}"/></dd><dt>Tên sản phẩm</dt><dd><c:out value="${product.name}"/></dd><dt>Giá (VNĐ)</dt><dd><c:out value="${product.price}"/></dd><dt>Số lượng</dt><dd><c:out value="${product.quantity}"/></dd><dt>Mô tả</dt><dd><c:out value="${product.description}"/></dd></dl><div class="buttons"><a class="btn primary" href="${pageContext.request.contextPath}/products?action=edit&id=${product.id}">Sửa sản phẩm</a><a class="btn" href="${pageContext.request.contextPath}/products">Quay lại</a></div></main></body></html>