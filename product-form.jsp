<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${pageTitle}"/></title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><main class="container narrow"><h1><c:out value="${pageTitle}"/></h1><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if>
<form class="product-form" method="post" action="${pageContext.request.contextPath}/products"><input type="hidden" name="action" value="${empty product ? 'add' : 'edit'}"><c:if test="${not empty product}"><input type="hidden" name="id" value="${product.id}"></c:if>
<label for="name">Tên sản phẩm *</label><input id="name" name="name" required maxlength="120" value="<c:out value='${product.name}'/>">
<label for="price">Giá (VNĐ) *</label><input id="price" name="price" type="number" min="0" step="0.01" required value="<c:out value='${product.price}'/>">
<label for="quantity">Số lượng *</label><input id="quantity" name="quantity" type="number" min="0" required value="<c:out value='${product.quantity}'/>">
<label for="description">Mô tả</label><textarea id="description" name="description" rows="4"><c:out value="${product.description}"/></textarea>
<div class="buttons"><button class="btn primary" type="submit">Lưu sản phẩm</button><a class="btn" href="${pageContext.request.contextPath}/products">Hủy</a></div></form></main></body></html>